{
  "name": "agent-sdlc",
  "version": "1.2.1",
  "private": true,
  "type": "module",
  "description": "Multi-agent SDLC kit — Cursor and Claude Code plugin with execution plan drain CLI (Cursor or Claude backend)",
  "bin": {
    "agent-sdlc-drain": "./bin/agent-sdlc-drain.mjs",
    "agent-sdlc-install": "./bin/agent-sdlc-install.mjs",
    "agent-sdlc-update": "./bin/agent-sdlc-update.mjs"
  },
  "scripts": {
    "setup": "npm install && tsx ./scripts/install.ts dev",
    "install:plugin": "tsx ./scripts/install.ts",
    "install:dev": "tsx ./scripts/install.ts dev",
    "install:cloud": "tsx ./scripts/install.ts cloud",
    "install:desktop": "tsx ./scripts/install.ts desktop",
    "install:global-cli": "tsx ./scripts/install.ts global-cli",
    "vendor": "tsx ./scripts/install.ts vendor-full",
    "vendor:minimal": "tsx ./scripts/install.ts vendor-minimal",
    "update": "tsx ./scripts/update.ts",
    "update:global-cli": "tsx ./scripts/update.ts global-cli",
    "execution-plans:drain": "tsx ./scripts/drain-execution-plans.ts",
    "test": "vitest run --config ./vitest.config.ts",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "verify:sync": "tsx ./scripts/verify-sync.ts"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.268",
    "@cursor/sdk": "^1.0.23",
    "tsx": "^4.19.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.20.2",
    "eslint": "^10.10.0",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.70.0",
    "vitest": "^3.0.0"
  }
}
